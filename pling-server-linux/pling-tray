#!/usr/bin/env python3
"""
Pling Server System Tray Launcher for Linux
"""
import os
import sys

base_dir = os.path.dirname(os.path.abspath(__file__))
candidate_paths = [
    base_dir,
    "/usr/local/share/pling",
    "/usr/share/pling"
]
for p in candidate_paths:
    if p not in sys.path and os.path.exists(p):
        sys.path.insert(0, p)

from pling.tray import main

if __name__ == "__main__":
    main()
