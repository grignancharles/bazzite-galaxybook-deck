#!/usr/bin/env python3
"""
MagicProxy CLI Utility
Allows checking live status, manual connect/disconnect, and logs.
"""

import sys
import os
import json
import time
import subprocess

STATUS_FILE = "/tmp/magicproxy_status.json"

def show_status():
    if not os.path.isfile(STATUS_FILE):
        print("MagicProxy Daemon: Inactivo o no iniciado.")
        return

    try:
        with open(STATUS_FILE, "r") as f:
            data = json.load(f)
        status = data.get("status", "desconocido")
        ip = data.get("ip")
        port = data.get("port")
        ts = data.get("timestamp", 0)
        age = int(time.time() - ts)

        if status == "connected":
            print(f"🟢 MagicProxy: CONECTADO a {ip}:{port} (hace {age}s)")
            print("   Túnel Layer-3 (tun69) activo con bypass TTL 65 y protección WebRTC IPv6.")
        elif status == "searching":
            print("🟡 MagicProxy: Buscando servidor iOS en la red local (_magicproxy._tcp.local)...")
            print("   Internet local normal activo (sin secuestro de rutas).")
        else:
            print("🔴 MagicProxy: Desconectado.")
    except Exception as e:
        print(f"Error leyendo estado: {e}")

def main():
    if len(sys.argv) < 2 or sys.argv[1] in ["status", "-s", "--status"]:
        show_status()
    elif sys.argv[1] == "restart":
        subprocess.run(["systemctl", "restart", "galaxybook-iphone-tunnel.service"])
        print("Servicio MagicProxy reiniciado.")
    elif sys.argv[1] == "log":
        subprocess.run(["journalctl", "-u", "galaxybook-iphone-tunnel.service", "-f"])
    elif sys.argv[1] in ["stop", "down"]:
        subprocess.run(["systemctl", "stop", "galaxybook-iphone-tunnel.service"])
        print("Servicio MagicProxy detenido.")
    elif sys.argv[1] in ["start", "up"]:
        subprocess.run(["systemctl", "start", "galaxybook-iphone-tunnel.service"])
        print("Servicio MagicProxy iniciado.")
    else:
        print("Uso: magicproxy [status|restart|log|start|stop]")

if __name__ == "__main__":
    main()
